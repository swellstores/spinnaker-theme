{
  "title": "Cart",
  "sections": [
    {
      "id": "cart-items",
      "type": "cart_items",
      "props": {
        "cart": "current",
        "continue_href": "/products",
        "products": {
          "from": "cart_products",
          "limit": 8
        }
      }
    },
    {
      "id": "cart-summary",
      "type": "cart_summary",
      "props": {
        "cart": "current",
        "cross_sells": {
          "from": "cart_cross_sells",
          "limit": 4
        },
        "show_note": "hide"
      }
    },
    {
      "id": "popular",
      "type": "product_band",
      "props": {
        "heading": "While you're here",
        "link_label": "Shop everything",
        "link_href": "/products",
        "products": {
          "from": "all",
          "sort": "best_selling",
          "limit": 4
        },
        "display": "grid",
        "per_row": "4",
        "heading_size": "medium",
        "tone": "highlight",
        "numbers": "no"
      }
    }
  ]
}
